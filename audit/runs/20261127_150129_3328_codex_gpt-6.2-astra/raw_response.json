L22: 
L23:     @Override
L24:     public void commence(
L25:             HttpServletRequest request,
L26:             HttpServletResponse response,
L27:             AuthenticationException authException
L28:     ) throws IOException, ServletException {
L29:         if (requestsJson(request)) {
L30:             response.setStatus(HttpServletResponse.SC_UNAUTHORIZED);
L31:             response.setContentType(MediaType.APPLICATION_JSON_VALUE);
L32:             response.setCharacterEncoding(StandardCharsets.UTF_8.name());
