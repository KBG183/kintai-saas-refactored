#!/bin/sh
# KINTAI Quality Pipeline - Enterprise Pre-Commit Hard-Gate (Blob-Safe & Fail-Closed Edition)

# 0. PCRE Engine Self-Test Canary (Fail-Closed Gate)
# Verifies grep -P supports UTF-8 PCRE. Exit code 2 indicates regex engine failure.
printf '\xec\x95\x88' | grep -P '(*UTF)[\x{ac00}-\x{d7a3}]' > /dev/null 2>&1
CANARY_EXIT=$?
if [ $CANARY_EXIT -eq 2 ]; then
    echo "[BLOCK] FATAL: grep -P (PCRE) regex engine failed or unsupported in this shell. Fail-Closed abort."
    exit 1
fi

# 1. Author Verification
AUTHOR_EMAIL=$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')
if [ "$AUTHOR_EMAIL" = "test@test.local" ] || [ -z "$AUTHOR_EMAIL" ]; then
    echo "[BLOCK] Invalid Git Author ($AUTHOR_EMAIL) detected."
    exit 1
fi

# 2. Extract staged diff additions (Captures all added lines, excluding +++ diff headers)
STAGED_DIFF=$(git diff --cached --unified=0 --no-color | grep -E '^\+[^+]')

# 3. Sensitive Data & Legacy Identifier Hard-Gate (Generalized private IP & path patterns)
SENSITIVE_PATTERN='(C:[\\/](Users|dev)[\\/][a-zA-Z0-9_\-]+|[a-zA-Z]:[\\/](Users|dev)[\\/]|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[0-1])\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})'
if echo "$STAGED_DIFF" | grep -qE "$SENSITIVE_PATTERN"; then
    echo "[BLOCK] Staged changes contain sensitive patterns or private paths:"
    echo "$STAGED_DIFF" | grep -E "$SENSITIVE_PATTERN" | head -n 5
    exit 1
fi

# 4. Zero-Korean Unicode Hard-Gate (Direct Staged Blob Inspection via git show)
KOREAN_REGEX='(*UTF)[\x{1100}-\x{11ff}\x{3130}-\x{318f}\x{a960}-\x{a97f}\x{ac00}-\x{d7a3}\x{d7b0}-\x{d7ff}\x{ffa0}-\x{ffdc}]'

git diff --cached --name-only -z --diff-filter=ACM | while IFS= read -r -d '' FILE; do
    if echo "$FILE" | grep -qE '(_KO\.|_ko\.)'; then
        continue
    fi
    
    # Inspect pure Staged Blob from Git index, immune to working-tree modifications
    if git show :"$FILE" 2>/dev/null | grep -P -n "$KOREAN_REGEX" > /dev/null 2>&1; then
        echo "[BLOCK] Zero-Korean violation: Staged index for '$FILE' contains Korean characters."
        git show :"$FILE" | grep -P -n "$KOREAN_REGEX" | head -n 3
        exit 1
    fi
done

if [ $? -ne 0 ]; then
    echo "[BLOCK] Korean characters are strictly forbidden in public files. Aborting commit."
    exit 1
fi

# 5. Master Deterministic Integrity Gate (Staged Assets & SSOT Verification)
if [ ! -f "tools/scripts/VerifySRS.exe" ]; then
    powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "tools/scripts/verify_srs.ps1" > /dev/null 2>&1
fi
if [ ! -f "tools/scripts/VerifySRS.exe" ]; then
    echo "[BLOCK] Failed to compile or find VerifySRS.exe. Aborting commit."
    exit 1
fi

SSOT_LINT_OUT=$(tools/scripts/VerifySRS.exe "config/srs_specification_ssot.md" 2>&1)
if [ $? -ne 0 ]; then
    echo "$SSOT_LINT_OUT"
    echo "[BLOCK] Deterministic Integrity verification failed on SSOT. Aborting commit."
    exit 1
fi
echo "  -> PASS: SSOT Master Linter verified."

STAGED_FAILED=0
git diff --cached --name-only -z --diff-filter=ACM | while IFS= read -r -d '' FILE; do
    if echo "$FILE" | grep -qE '^(domain_target/.*|tools/scripts/VerifySRS.*\.cs|config/.*\.md)$'; then
        if [ -f "$FILE" ] && [ "$FILE" != "config/srs_specification_ssot.md" ]; then
            FILE_LINT_OUT=$(tools/scripts/VerifySRS.exe "$FILE" 2>&1)
            if [ $? -ne 0 ]; then
                echo "$FILE_LINT_OUT"
                echo "[BLOCK] Deterministic Integrity verification failed on staged file: $FILE"
                exit 1
            fi
        fi
    fi
done

if [ $? -ne 0 ]; then
    echo "[BLOCK] Deterministic Integrity verification failed on staged domain/linter assets. Aborting commit."
    exit 1
fi

# 6. Master Repository Total Integrity Verification (12 Checks)
TOTAL_INTEGRITY_OUT=$(powershell.exe -ExecutionPolicy Bypass -File "tools/scripts/verify_repo_total_integrity.ps1" -NoLog 2>&1)
if [ $? -ne 0 ]; then
    echo "$TOTAL_INTEGRITY_OUT"
    echo "[BLOCK] Repository Total Integrity verification failed. Aborting commit."
    exit 1
fi
echo "  -> PASS: 12-Gate Total Integrity verified."

exit 0
